<UserControl x:Class="FitnessTracker.Views.WorkoutSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="900">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,15">
      <TextBlock Text="Log Workout Session" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Session Date:" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <DatePicker SelectedDate="{Binding SessionDate}" Width="150"/>
      </StackPanel>
    </StackPanel>

    <!-- Main content area -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Exercise and Set Entry -->
      <StackPanel Grid.Column="0">
        <TextBlock Text="Add Exercise" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <!-- Category Selection -->
        <TextBlock Text="Category:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding ExerciseCategoriesList}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,15"/>

        <!-- Exercise Template Selection (filtered by category) -->
        <TextBlock Text="Exercise:" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding ExerciseTemplateList}"
                  SelectedItem="{Binding SelectedTemplate}"
                  DisplayMemberPath="Name"
                  Margin="0,0,0,20"/>

        <Separator Margin="0,0,0,15"/>

        <!-- Set Entry -->
        <TextBlock Text="Add Set" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Column="0" Grid.Row="0" Text="Set #" Margin="0,0,0,5"/>
          <TextBox Grid.Column="0" Grid.Row="1" Text="{Binding SetNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

          <TextBlock Grid.Column="2" Grid.Row="0" Text="Weight" Margin="0,0,0,5"/>
          <TextBox Grid.Column="2" Grid.Row="1" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>

          <TextBlock Grid.Column="4" Grid.Row="0" Text="Reps" Margin="0,0,0,5"/>
          <TextBox Grid.Column="4" Grid.Row="1" Text="{Binding Repetitions, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"/>
        </Grid>

        <Button Content="Add Set"
                Command="{Binding AddSetCommand}"
                Width="100"
                HorizontalAlignment="Left"
                Padding="10,5"
                Margin="0,0,0,15"/>

        <Button Content="Complete Exercise"
                Command="{Binding CompleteExerciseCommand}"
                Width="140"
                HorizontalAlignment="Left"
                Padding="10,5"
                Background="#4CAF50"
                Foreground="White"/>
      </StackPanel>

      <!-- Middle: Current Sets -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Current Sets" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Sets}"
                  BorderBrush="LightGray"
                  BorderThickness="1">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Set" Width="40" DisplayMemberBinding="{Binding SetNumber}"/>
              <GridViewColumn Header="Weight" Width="60" DisplayMemberBinding="{Binding Weight}"/>
              <GridViewColumn Header="Reps" Width="50" DisplayMemberBinding="{Binding Repetitions}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>

      <!-- Right: Completed Exercises -->
      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Completed Exercises" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- Exercises with nested Sets -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding CompletedExercises}"
                  BorderBrush="LightGray"
                  BorderThickness="1">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ItemsControl ItemsSource="{Binding Sets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="10,0,0,2">
                        <Run Text="Set "/>
                        <Run Text="{Binding SetNumber, Mode=OneWay}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding Weight, Mode=OneWay}"/>
                        <Run Text=" lbs × "/>
                        <Run Text="{Binding Repetitions, Mode=OneWay}"/>
                        <Run Text=" reps"/>
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>

    <!-- Bottom: Save/Clear -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,0">
      <Button Content="Save Workout"
              Command="{Binding SaveCommand}"
              Width="120"
              Margin="0,0,10,0"
              Padding="10,5"
              Background="#2196F3"
              Foreground="White"/>
      <Button Content="Clear All" Command="{Binding ClearCommand}" Width="80" Padding="10,5"/>
    </StackPanel>
  </Grid>
</UserControl>